# =====================================================================
# การตั้งค่าแจ้งเตือน (Telegram / Discord)
# =====================================================================
# หากต้องการแจ้งเตือนผ่าน Telegram ให้ใส่ Bot Token และ Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# หากต้องการแจ้งเตือนผ่าน Discord ให้ใส่ Webhook URL
DISCORD_WEBHOOK_URL=

# ระยะเวลาหน่วงการแจ้งเตือนซ้ำต่อเหรียญและประเภทสัญญาณ (วินาที)
ALERT_COOLDOWN_SECS=900

# =====================================================================
# ขอบเขตการคัดกรองเหรียญ (USDT-M Perpetual Futures)
# =====================================================================
# คัดเฉพาะเหรียญที่มีมูลค่าการซื้อขาย 24 ชั่วโมง (Quote Volume USDT) ขั้นต่ำ
MIN_QUOTE_VOLUME_24H=20000000
# จำนวนเหรียญสูงสุดที่จะติดตามพร้อมกัน (เรียงตาม Volume สูงสุด)
MAX_SYMBOLS=150
# Timeframe ของแท่งเทียน (เช่น 1m, 3m, 5m, 15m, 1h)
KLINE_INTERVAL=5m
# จำนวนแท่งเทียนย้อนหลังที่เก็บในหน่วยความจำต่อเหรียญ
CANDLE_BUFFER_SIZE=100

# =====================================================================
# เงื่อนไขที่ 1: ความผันผวนของราคา & วอลุ่มพุ่ง (Price Pump/Dump & Volume Spike)
# =====================================================================
# เปอร์เซ็นต์การเปลี่ยนแปลงราคาภายในแท่งเทียนปัจจุบันเพื่อแจ้งเตือน Pump / Dump (%)
PRICE_CHANGE_THRESHOLD_PCT=2.5
# อัตราส่วนวอลุ่มพุ่งเทียบกับค่าเฉลี่ยย้อนหลัง (เท่า)
VOLUME_SPIKE_MULTIPLIER=3.5
# จำนวนแท่งเทียนย้อนหลังสำหรับคำนวณค่าเฉลี่ยวอลุ่ม
VOLUME_LOOKBACK=20

# =====================================================================
# เงื่อนไขที่ 2: อินดิเคเตอร์ทางเทคนิค (RSI, EMA Crossover, Bollinger Bands)
# =====================================================================
RSI_PERIOD=14
RSI_OVERBOUGHT=75.0
RSI_OVERSOLD=25.0

EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

BB_PERIOD=20
BB_STD_DEV=2.0
# วอลุ่มขั้นต่ำ (เท่าของค่าเฉลี่ย) เมื่อราคาปิดทะลุกรอบ Bollinger Band
BB_MIN_VOLUME_RATIO=1.8

# =====================================================================
# เงื่อนไขที่ 3: ข้อมูล Futures เฉพาะทาง (Funding Rate, Open Interest, Liquidation)
# =====================================================================
# แจ้งเตือนเมื่อ |Funding Rate| >= ค่านี้ (หน่วยเป็น % เช่น 0.10 คือ +0.10% หรือ -0.10%)
FUNDING_RATE_THRESHOLD_PCT=0.10
# แจ้งเตือนเมื่อ Open Interest เปลี่ยนแปลง >= ค่านี้ (%) ภายในรอบการดึงข้อมูล
OI_SPIKE_THRESHOLD_PCT=3.0
# รอบเวลาตรวจสอบ Funding Rate และ Open Interest (วินาที)
FUTURES_POLL_INTERVAL_SECS=60
# มูลค่าขั้นต่ำของการบังคับล้างพอร์ต (Liquidation) ต่อออเดอร์ (USD)
MIN_LIQUIDATION_USD=50000

# =====================================================================
# ระบบจำลองการเทรด (Paper Trading Simulator)
# =====================================================================
# เปิด/ปิดระบบจำลองการเทรดอัตโนมัติ (true / false)
PAPER_TRADING_ENABLED=true
# เงินทุนจำลองเริ่มต้น (USDT)
PAPER_INITIAL_BALANCE=1000.0
# Leverage ที่ใช้จำลอง (เช่น 10 = 10x)
PAPER_LEVERAGE=10.0
# ขนาด Margin ต่อออเดอร์ (% ของพอร์ตปัจจุบัน)
PAPER_POSITION_PCT=10.0
# จำนวนออเดอร์ที่เปิดพร้อมกันได้สูงสุด
PAPER_MAX_OPEN_POSITIONS=5
# เกณฑ์คะแนนความแม่นยำขั้นต่ำในการเปิดออเดอร์ (2 = 2-3 ดาว, 3 = เฉพาะ 3 ดาว)
PAPER_MIN_STARS=2
# ค่าธรรมเนียมจำลองต่อข้าง (%) เช่น 0.05 = Binance Futures Taker 0.05%
PAPER_TAKER_FEE_PCT=0.05
# แจ้งเตือนการเปิด/ปิดออเดอร์จำลองเข้า Telegram/Discord ด้วยหรือไม่
PAPER_NOTIFY_WEBHOOKS=true
# ไฟล์บันทึกสถานะพอร์ตและประวัติการเทรด
PAPER_STATE_FILE=paper_state.json
PAPER_TRADES_CSV=paper_trades.csv

